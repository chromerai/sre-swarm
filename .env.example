# ── Postgres ──────────────────────────────────────────
POSTGRES_USER=sre_swarm
POSTGRES_PASSWORD=yourpasswordhere
POSTGRES_DB=sre_swarm
POSTGRES_URL=postgresql+asyncpg://sre_swarm:yourpasswordhere@localhost:5432/sre_swarm

# ── NATS ──────────────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai

# ── Detection ─────────────────────────────────────────
K8S_WATCH_ENABLED=false
PROMETHEUS_URL=
LOKI_URL=
HEALTH_PROBE_ENABLED=false
SYNTHETIC_PROBE_ENABLED=false

# ── Remediation ───────────────────────────────────────
REMEDIATION_MODE=notify
ENABLE_LLM_DEBATE=false
ENABLE_TREND_PREDICTION=false

# ── Agent Behaviour ───────────────────────────────────
LOG_LEVEL=INFO
MAX_CONTEXT_TOKENS=4000
AGENT_HEARTBEAT_TIMEOUT_SECONDS=30
RECOVERY_COOLDOWN_SECONDS=60
MAX_RETRIES_PER_STATE=2

# ── Paths ─────────────────────────────────────────────
RUNBOOK_DIR=agents/remediator/runbooks
POLICY_CONFIG_PATH=agents/safety/policies.yaml
TOPOLOGY_CONFIG_PATH=agents/safety/topology.yaml

# ── Safety ────────────────────────────────────────────
APPROVAL_CHANNELS=dashboard

# ── Vector Store ──────────────────────────────────────
VECTOR_BACKEND=chroma

# ── Testing ───────────────────────────────────────────
AUTO_APPROVE=false